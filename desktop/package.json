{
  "name": "capwiz-desktop",
  "version": "0.1.0",
  "description": "CapWiz — desktop app (Electron shell + Python sidecar)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Nicola Preda",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.predanicola.capwiz",
    "productName": "CapWiz",
    "files": [
      "electron/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    }
  }
}
