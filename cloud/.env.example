# Copy to .env and fill in. NEVER commit the real .env.

# Auth — generate a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30

# Database — sqlite for local dev, Postgres URL in production
DATABASE_URL=sqlite:///./capwiz_cloud.db

# Stripe — from the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...            # the recurring price for the subscription
STRIPE_WEBHOOK_SECRET=whsec_...      # from `stripe listen` or the dashboard webhook

# Where Stripe redirects after checkout/portal (simple hosted pages)
CHECKOUT_SUCCESS_URL=https://tuosito.it/success
CHECKOUT_CANCEL_URL=https://tuosito.it/cancel
PORTAL_RETURN_URL=https://tuosito.it/account
